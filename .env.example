# Supabase — already in use
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# LINE Official Account (server-only — never prefix with NEXT_PUBLIC_)
# Used by the future /api/line/send route handler to push messages /
# document images to customers. The lib/lineOA.ts stub stays inert
# until these are populated AND the server route is wired.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_OA_ID=

# Google Sheets order sync (server-only — never prefix with NEXT_PUBLIC_)
# /api/sync-order-to-sheet writes each new order as a row in the workbook
# below. Until these are set the route returns 503 with a Thai message.
#
# GOOGLE_PRIVATE_KEY note: paste the entire service-account private key in
# one line, using literal "\n" sequences (Vercel converts them back to real
# line breaks at runtime). Example value shape:
#   "-----BEGIN PRIVATE KEY-----\nMIIEvgIBA...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=1m1CEANwJLAXhw3Y1wtRoCS99Dplj8AuW_9aOtZ_iza4
# Optional override — defaults to "Front_Desk" if unset.
GOOGLE_SHEET_ORDER_TAB=Front_Desk
# Optional override for the Pricing snapshot tab written by
# /api/sync-pricing-to-sheet. Defaults to "Pricing".
GOOGLE_SHEET_PRICING_TAB=Pricing

# Optional override for the Expense_Log sync workbook. Defaults to the same
# sheet as GOOGLE_SHEET_ID when unset.
EXPENSE_SHEET_ID=
